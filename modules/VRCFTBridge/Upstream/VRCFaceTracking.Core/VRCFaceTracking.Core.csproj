<Project Sdk="Microsoft.NET.Sdk">
  <!-- The part of VRCFaceTracking.Core (Apache-2.0) that tracking modules
       use. Modules reference it by this assembly name; the version must not
       be lower than the one they were built against. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>VRCFaceTracking.Core</AssemblyName>
    <AssemblyVersion>6.0.0.0</AssemblyVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0618;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VRCFaceTracking.SDK\VRCFaceTracking.SDK.csproj" />
  </ItemGroup>
</Project>
